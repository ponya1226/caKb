{
  "name": "local-kakeibo-pwa",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:e2e-harness": "vite --host 127.0.0.1 --port 4174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "lint:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run src",
    "test:e2e": "npm run lint:e2e && npm run build && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:rules": "npx --yes firebase-tools@14.16.0 emulators:exec --only firestore --project demo-cakb \"vitest run tests/firestore.rules.test.ts\"",
    "deploy:hosting": "npm run build && npx --yes firebase-tools@14.16.0 deploy --only hosting --project cakb-dev",
    "deploy:rules": "npx --yes firebase-tools@14.16.0 deploy --only firestore:rules --project cakb-dev"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.9"
  }
}
